<div class="layout layout--col layout--stretch ins-layout ins-layout--full">
  {% if has_data %}
    <div class="ins-header flex flex--row flex--between flex--center-y gap--medium">
      <div class="ins-brand flex flex--row flex--center-y">
        <span class="ins-brand__name">In Season</span>
      </div>
      <div class="ins-header__copy">
        <div class="ins-heading title title--large"><span class="ins-heading__month">{{ month_name | escape }}</span> <span class="ins-heading__place">{{ country_name | escape }}</span></div>
      </div>
    </div>

    {% if has_items %}
      <div class="ins-board ins-board--{{ shortlist.layout_balance }}">
      <section class="ins-section ins-section--fruit rounded">
        <div class="ins-section__header p--2 flex flex--col flex--center">
          <img class="ins-section__art ins-section__art--fruit" src="{{ ins_fruit_art }}" alt="Fruit">
        </div>
        <div class="ins-category-list ins-category-list--fruit">
          {% for category in shortlist.fruits.categories %}
            <div class="ins-category">
              <span class="ins-category__name">{{ category.name | escape }}</span> <span class="ins-category__examples">{% for example in category.examples %}{{ example.name | escape }}{% unless forloop.last %}, {% endunless %}{% endfor %}</span>
            </div>
          {% endfor %}
        </div>
      </section>

      <section class="ins-section ins-section--vegetables rounded">
        <div class="ins-section__header p--2 flex flex--col flex--center">
          <img class="ins-section__art ins-section__art--vegetables" src="{{ ins_vegetable_art }}" alt="Vegetables">
        </div>
        <div class="ins-category-list ins-category-list--vegetables">
          {% for category in shortlist.vegetables.categories %}
            <div class="ins-category">
              <span class="ins-category__name">{{ category.name | escape }}</span> <span class="ins-category__examples">{% for example in category.examples %}{{ example.name | escape }}{% unless forloop.last %}, {% endunless %}{% endfor %}</span>
            </div>
          {% endfor %}
        </div>
      </section>
      </div>
    {% else %}
      <div class="ins-quiet rounded flex flex--col flex--center text--center">
        <div class="label label--small label--inverted">A quiet month</div>
        <div class="title title--large">No common fresh harvests</div>
        <div class="label label--base">Nothing meets this national guide's conservative threshold in {{ month_name | escape }}.</div>
      </div>
    {% endif %}
  {% else %}
    <div class="ins-empty rounded flex flex--col flex--center text--center">
      <div class="ins-empty__mark rounded--full flex flex--center">?</div>
      <div class="label label--small label--inverted">Setup needed</div>
      <div class="title title--large">Choose your country</div>
      <div class="ins-empty__message label label--base">{{ error_message | escape }}</div>
    </div>
  {% endif %}
</div>
