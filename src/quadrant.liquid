<div class="layout layout--col layout--stretch ins-layout ins-layout--quadrant">
  {% if has_data %}
    <div class="ins-header flex flex--row flex--between flex--center-y gap--small">
      <div class="ins-brand flex flex--row flex--center-y">
        <span class="ins-brand__name">In Season</span>
      </div>
      <div class="ins-header__copy">
        <div class="ins-heading title title--small"><span class="ins-heading__month">{{ month_name | escape }}</span> <span class="ins-heading__place">{{ country_short_name | escape }}</span></div>
      </div>
    </div>

    {% if has_items %}
      <div class="ins-board">
      <section class="ins-section rounded--small flex flex--col">
        <div class="ins-section__header p--1 flex flex--center flex--center-y">
          <img class="ins-section__art ins-section__art--fruit" src="{{ ins_fruit_art }}" alt="Fruit">
          {% if compact.quadrant.fruits.more_count > 0 %}<span class="ins-section__count">+{{ compact.quadrant.fruits.more_count }} groups</span>{% endif %}
        </div>
        <div class="ins-category-list">
          {% for category in compact.quadrant.fruits.categories %}
            <div class="ins-category">
              <div class="ins-category__name">{{ category.name | escape }}</div>
              <div class="ins-category__examples">{% for example in category.examples %}{{ example.name | escape }}{% unless forloop.last %}, {% endunless %}{% endfor %}</div>
            </div>
          {% endfor %}
          {% if fruit_count == 0 %}
            <div class="ins-harvest-quiet flex flex--col flex--center text--center">
              <div class="label label--small label--inverted">Out of season</div>
              <div class="title title--small">No fruit in season</div>
            </div>
          {% endif %}
        </div>
      </section>

      <section class="ins-section rounded--small flex flex--col">
        <div class="ins-section__header p--1 flex flex--center flex--center-y">
          <img class="ins-section__art ins-section__art--vegetables" src="{{ ins_vegetable_art }}" alt="Vegetables">
          {% if compact.quadrant.vegetables.more_count > 0 %}<span class="ins-section__count">+{{ compact.quadrant.vegetables.more_count }} groups</span>{% endif %}
        </div>
        <div class="ins-category-list">
          {% for category in compact.quadrant.vegetables.categories %}
            <div class="ins-category">
              <div class="ins-category__name">{{ category.name | escape }}</div>
              <div class="ins-category__examples">{% for example in category.examples %}{{ example.name | escape }}{% unless forloop.last %}, {% endunless %}{% endfor %}</div>
            </div>
          {% endfor %}
          {% if vegetable_count == 0 %}
            <div class="ins-harvest-quiet flex flex--col flex--center text--center">
              <div class="label label--small label--inverted">Out of season</div>
              <div class="title title--small">No vegetables in season</div>
            </div>
          {% endif %}
        </div>
      </section>
      </div>
    {% else %}
      <div class="ins-quiet rounded flex flex--col flex--center text--center">
        <div class="label label--small label--inverted">A quiet month</div>
        <div class="label label--small">No common fresh harvests</div>
      </div>
    {% endif %}
  {% else %}
    <div class="ins-empty rounded flex flex--col flex--center text--center">
      <div class="label label--small label--inverted">Setup needed</div>
      <div class="title title--small">Choose your country</div>
    </div>
  {% endif %}
</div>
